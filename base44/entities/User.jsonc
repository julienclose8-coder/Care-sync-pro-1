{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "availability": {
      "type": "array",
      "description": "Recurring weekly availability",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "day",
          "start",
          "end"
        ]
      }
    },
    "trainings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Trainings approved by the admin for this worker"
    },
    "pay_account_name": {
      "type": "string"
    },
    "bsb": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "payroll_reference": {
      "type": "string"
    },
    "hourly_pay_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "saturday_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Hourly rate for shifts on a Saturday; 0 uses the base hourly rate"
    },
    "sunday_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Hourly rate for shifts on a Sunday; 0 uses the base hourly rate"
    },
    "sleepover_flat_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Flat rate paid for the sleep window of a sleepover shift, in addition to hourly pay for awake hours"
    },
    "overtime_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Hourly rate for hours beyond 10 worked in a single non-sleepover shift; 0 uses 1.5x the applicable hourly rate"
    },
    "weekly_hour_limit": {
      "type": "number",
      "minimum": 0,
      "default": 38
    },
    "hour_limit_action": {
      "type": "string",
      "enum": [
        "warning",
        "block"
      ],
      "default": "warning"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "file_url"
        ]
      }
    }
  },
  "required": [
    "role"
  ]
}