{
  "name": "TimeCorrection",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "original_clock_in": {
      "type": "string"
    },
    "original_clock_out": {
      "type": "string"
    },
    "original_status": {
      "type": "string"
    },
    "proposed_clock_in": {
      "type": "string"
    },
    "proposed_clock_out": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "worker_id",
    "proposed_clock_in",
    "proposed_clock_out",
    "reason",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}