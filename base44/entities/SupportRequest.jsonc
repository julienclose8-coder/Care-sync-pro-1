{
  "name": "SupportRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "new",
        "change",
        "cancel",
        "goal"
      ],
      "default": "new"
    },
    "service_type": {
      "type": "string",
      "default": "Personal Care"
    },
    "support_setting": {
      "type": "string",
      "enum": [
        "in_home",
        "centre_based"
      ]
    },
    "centre_name": {
      "type": "string"
    },
    "centre_address": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "preferred_times": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "request_type",
    "service_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}