{
  "name": "PolicyDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Full text of the policy or procedure"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "policy",
        "procedure"
      ],
      "default": "policy"
    }
  },
  "required": [
    "title",
    "document_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}