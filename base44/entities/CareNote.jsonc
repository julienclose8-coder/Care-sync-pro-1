{
  "name": "CareNote",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "note_category": {
      "type": "string",
      "enum": [
        "general",
        "support",
        "supports",
        "progress",
        "medication",
        "observation",
        "behavioural",
        "behaviours",
        "moods",
        "locked_concern"
      ],
      "default": "general",
      "enumColors": [
        "gray",
        "blue",
        "blue",
        "green",
        "purple",
        "blue",
        "pink",
        "pink",
        "yellow",
        "red"
      ]
    },
    "behavioural_subtype": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "Positive or negative behaviour, used only for behavioural notes"
    },
    "content": {
      "type": "string",
      "maxLength": 20000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "final",
      "enumColors": [
        "yellow",
        "green"
      ],
      "description": "Draft notes are AI-generated and editable by the worker until finalized"
    }
  },
  "required": [
    "client_id",
    "author_id",
    "author_name",
    "note_category",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.note_category": "locked_concern"
            },
            {
              "data.author_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.note_category": {
                "$ne": "locked_concern"
              }
            },
            {
              "$or": [
                {
                  "data.author_id": "{{user.id}}"
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}