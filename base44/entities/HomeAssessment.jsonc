{
  "name": "HomeAssessment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "access_details": {
      "type": "string"
    },
    "pets": {
      "type": "string"
    },
    "smoke_alarms_ok": {
      "type": "boolean",
      "default": false
    },
    "pathways_clear": {
      "type": "boolean",
      "default": false
    },
    "electrical_safe": {
      "type": "boolean",
      "default": false
    },
    "bathroom_safe": {
      "type": "boolean",
      "default": false
    },
    "medications_secured": {
      "type": "boolean",
      "default": false
    },
    "hazard_notes": {
      "type": "string"
    },
    "other_notes": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}