{
  "name": "Client",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "funding_type": {
      "type": "string",
      "enum": [
        "NDIS",
        "Home Care Package",
        "Private",
        "Other"
      ],
      "default": "NDIS"
    },
    "plan_manager": {
      "type": "string"
    },
    "hourly_charge_rate": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "support_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hourly_rate": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "hourly_rate"
        ]
      },
      "description": "Client-specific custom support names and hourly billing rates"
    },
    "support_needs": {
      "type": "string"
    },
    "preferences": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string"
    },
    "in_home_support": {
      "type": "boolean",
      "default": false
    },
    "support_setting": {
      "type": "string",
      "enum": [
        "in_home",
        "centre_based"
      ]
    },
    "centre_name": {
      "type": "string"
    },
    "centre_address": {
      "type": "string"
    },
    "setting_supports": {
      "type": "object",
      "properties": {
        "in_home": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "centre_based": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Support request choices per setting; an empty list uses the standard support choices"
    },
    "training_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disability_info": {
      "type": "string",
      "description": "Client disability and care context"
    },
    "medication_info": {
      "type": "string",
      "description": "Client medication support information"
    },
    "plan_instructions": {
      "type": "string",
      "description": "Client support plan instructions"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_hold",
        "inactive"
      ],
      "default": "active"
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "service_type": {
          "type": "string"
        },
        "weekly_hours": {
          "type": "number",
          "minimum": 0
        },
        "quoted_hourly_rate": {
          "type": "number",
          "minimum": 0
        },
        "weekly_estimate": {
          "type": "number",
          "minimum": 0
        },
        "quotation_notes": {
          "type": "string"
        },
        "required_documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive_reason": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}