{
  "name": "RosterAcknowledgement",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_email": {
      "type": "string"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "assignment",
        "change",
        "removal"
      ]
    },
    "client_name": {
      "type": "string"
    },
    "previous_summary": {
      "type": "string"
    },
    "current_summary": {
      "type": "string"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "acknowledged",
        "superseded"
      ],
      "default": "pending"
    },
    "requested_by": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string"
    },
    "acknowledged_by": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "revision",
    "worker_id",
    "change_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.worker_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}