{
  "name": "WorkerLeaveRequest",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string"
    },
    "worker_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worker_name": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "leave",
        "unavailability"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "all_day": {
      "type": "boolean",
      "default": true
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "worker_id",
    "worker_ids",
    "worker_name",
    "request_type",
    "start_date",
    "end_date",
    "all_day",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}