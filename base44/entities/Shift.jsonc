{
  "name": "Shift",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "default": "Personal Care"
    },
    "support_setting": {
      "type": "string",
      "enum": [
        "in_home",
        "centre_based"
      ]
    },
    "centre_name": {
      "type": "string"
    },
    "centre_address": {
      "type": "string"
    },
    "is_sleepover": {
      "type": "boolean",
      "default": false,
      "description": "Sleepover shift: the sleep window is paid a flat rate and the awake hours an hourly rate"
    },
    "sleep_start": {
      "type": "string",
      "description": "Start of the sleepover sleep window (HH:MM)"
    },
    "sleep_end": {
      "type": "string",
      "description": "End of the sleepover sleep window (HH:MM)"
    },
    "goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurrence_series_id": {
      "type": "string"
    },
    "recurrence_mode": {
      "type": "string",
      "enum": [
        "none",
        "end_date",
        "week_count",
        "ongoing"
      ],
      "default": "none"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence_week_count": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "roster_revision": {
      "type": "string"
    },
    "acknowledgement_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "acknowledged"
      ],
      "default": "not_required"
    },
    "acknowledged_at": {
      "type": "string"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "needs_replacement": {
      "type": "boolean",
      "default": false,
      "description": "Set true when the assigned worker has called in sick; the roster flags the shift for a replacement"
    },
    "replacement_reason": {
      "type": "string",
      "description": "Reason recorded when the assigned worker called in sick"
    }
  },
  "required": [
    "client_id",
    "date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}